# ─────────────────────────────────────────────────────────────
#  Bibliorate — Environment Variables Template
#  Kopyalayın: cp .env.example .env
#  .env dosyasını ASLA git'e commit etmeyin!
# ─────────────────────────────────────────────────────────────

# ── Veritabanı (MySQL / Aiven) ────────────────────────────────
DB_CONNECTION_STRING=Server=<host>;Port=<port>;Database=defaultdb;User=avnadmin;Password=<password>;SslMode=Required;

# Aynı bağlantı Flask servisi için (SQLAlchemy formatı)
DATABASE_URL=mysql+pymysql://avnadmin:<password>@<host>:<port>/defaultdb?ssl_ca=/path/to/ca.pem

# ── Google Books API ──────────────────────────────────────────
GoogleBooksApiKey=AIzaSy_REPLACE_WITH_YOUR_KEY

# ── ASP.NET Core (.NET API) ───────────────────────────────────
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080

# ── Flask Analytics Microservice ──────────────────────────────
FLASK_ENV=production
FLASK_PORT=5000
# Flask → .NET API iletişimi için
DOTNET_API_BASE_URL=https://bibliorate-pmf4.onrender.com

# ── React Frontend ────────────────────────────────────────────
# Vite/React .env dosyası client/.env olarak ayrı tutulur
# VITE_API_BASE_URL=https://bibliorate-pmf4.onrender.com
# VITE_FLASK_API_URL=https://<flask-service>.onrender.com

# ── JWT (ileride eklenirse) ───────────────────────────────────
# JWT__Secret=your_jwt_secret_key_min_32_chars
# JWT__Issuer=bibliorate
# JWT__Audience=bibliorate-client
# JWT__ExpiryMinutes=60

# ── Docker / Container ────────────────────────────────────────
WEB_CONCURRENCY=1
